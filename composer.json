{
  "name": "mbridge-pl-agency/mautic-consent-for-elementor",
  "description": "Auto-inject marketing consent checkbox into Elementor Pro forms and sync to Mautic.",
  "type": "wordpress-plugin",
  "license": "GPL-2.0-or-later",
  "require": {
    "php": ">=8.1"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.5",
    "brain/monkey": "^2.6",
    "php-stubs/wordpress-stubs": "^6.4"
  },
  "autoload": {
    "psr-4": {
      "WPME\\": "includes/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "WPME\\Tests\\": "tests/"
    }
  },
  "config": {
    "sort-packages": true
  }
}
